# Runtime Gateway 只应监听本机回环地址。
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 本地模型子进程日志。
GATEWAY_WORKER_LOG=~/.cache/muse/local-worker.log
GATEWAY_WORKER_START_TIMEOUT=30

# 团队 AutoDL 实例统一约定。
GATEWAY_REMOTE_ENV_FILE=/root/muse-diffusion/.env
GATEWAY_REMOTE_PORT=6006
GATEWAY_REMOTE_START_COMMAND='cd /root/muse-diffusion && bash autodl/start-background.sh'
GATEWAY_REMOTE_START_TIMEOUT=120
