# 必填：使用 `openssl rand -hex 32` 生成，不要把真实值提交到 Git。
API_KEY=replace-with-a-long-random-secret

# 逗号分隔。保留 localhost 后，本机打开的前端可以访问远程服务器。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 动漫向 SDXL 模型。首次启动会下载约数 GB 的模型文件。
MODEL_ID=cagliostrolab/animagine-xl-4.0
TORCH_DTYPE=float16
PRELOAD_MODEL=true
LOW_VRAM=false

# 严格主体校验器仅在第一次需要时下载到服务器的 HF_HOME。
SUBJECT_VERIFIER_MODEL=SmilingWolf/wd-swinv2-tagger-v3
SUBJECT_VALIDATION_THRESHOLD=0.28
SUBJECT_VALIDATION_MARGIN=0.08
SUBJECT_VALIDATION_COUNT_THRESHOLD=0.28
HUMAN_INTEGRITY_THRESHOLD=0.28

# “鬼灭之刃画风”选项对应的服务器 LoRA 文件。
DEMONSLAYER_LORA_PATH=/root/autodl-tmp/muse-models/loras/demonslayer/Demonslayer_style_lora-.safetensors

# 仅在模型仓库要求登录或限流时填写。
HF_TOKEN=
HF_HUB_DISABLE_XET=1

# 直接使用服务器 IP 时可设为 0.0.0.0，并用防火墙限制端口。
API_BIND_ADDRESS=127.0.0.1

# 使用 compose.https.yaml 时填写已解析到服务器的域名。
API_DOMAIN=diffusion.example.com
